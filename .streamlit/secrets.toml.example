# The hosted app's only secret: the public_app login, which can read
# marts_public and nothing else. Never put any other login here.
# Locally: copy to .streamlit/secrets.toml (gitignored). Deployed: paste into
# the app's secrets on Streamlit Community Cloud.
database_url = "postgresql://public_app:<password>@<host>/<database>?sslmode=require"
